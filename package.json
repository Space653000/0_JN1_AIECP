{
  "name": "ai-engineering-control-plane",
  "version": "0.2.0",
  "description": "Windows-first local AI engineering control plane for official ChatGPT Web safe handoff and governed local execution.",
  "main": "electron/main.cjs",
  "author": "Space653000",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/mcp-server.mjs && node --check electron/preload.cjs && node --check electron/lib/protocol.cjs && node --check electron/lib/path-safety.cjs && node --check electron/lib/version.cjs && node --check ui/app.js",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run check && npm test",
    "dist:auto": "electron-builder --win nsis --x64 --arm64 --publish never -c.win.artifactName=AI-Engineering-Control-Plane-Setup-${version}.${ext}",
    "dist:x64": "electron-builder --win nsis --x64 --publish never",
    "dist:arm64": "electron-builder --win nsis --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "io.github.space653000.aecp",
    "productName": "AI Engineering Control Plane",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "package.json",
      "LICENSE",
      "electron/mcp-server.mjs"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "AI-Engineering-Control-Plane-Setup-${arch}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Engineering Control Plane",
      "uninstallDisplayName": "AI Engineering Control Plane"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "4.6.5"
  }
}
